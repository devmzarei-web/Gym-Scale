generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Day {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum TrainerTier {
  FREE
  PRO
}

enum Role {
  SUPER_ADMIN
  TRAINER
  CLIENT
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  PENDING
  CANCELLED
}

enum ExerciseGroupType {
  NORMAL
  SUPERSET
  TRISET
  CIRCUIT
  DROPSET
  REST_PAUSE
  TEMPO
}

model Trainer {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String    @default("$2a$10$e7eGfT3F...placeholder") // Bcrypt hash
  phone             String?
  avatarUrl         String?
  bio               String?
  role              Role      @default(TRAINER)
  isApproved        Boolean   @default(true)
  trainerCode       String?   @unique
  securityQuestion  String?
  securityAnswer    String?
  isDemo            Boolean   @default(false)
  maxClients        Int?      @default(10) // Custom limit for demo trainers
  canCreateDiets    Boolean   @default(true)
  canCreateRoutines Boolean   @default(true)
  canAccessRecipes  Boolean   @default(true)
  expiresAt         DateTime? // Expiration date for demo access
  
  tier              TrainerTier @default(FREE)
  aiQuota           Int       @default(3) // AI generation quota
  aiQuotaResetAt    DateTime? 

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  clients       Client[]
  routines      Routine[]
  dietPlans     DietPlan[]
  recipes       Recipe[]
  subscriptions Subscription[]
}

model Client {
  id               String   @id @default(cuid())
  trainerId        String?
  trainer          Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  name             String
  email            String?  @unique
  password         String?  // Bcrypt hash for client login
  role             Role     @default(CLIENT)
  securityQuestion String?
  securityAnswer   String?
  phone            String?
  age              Int?
  weight           Float?
  height           Float?
  gender           String?  @default("MALE")
  goals            String?
  primarySport     String?  // e.g. "شنا", "فوتبال"
  notes            String?
  photoUrls        String[]
  isDeleted        Boolean  @default(false)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions  Subscription[]
  routineHistory ClientRoutineHistory[]
  dietHistory    ClientDietHistory[]
  progressLogs   ClientProgressLog[]
  workoutLogs    WorkoutSessionLog[]
  foodLogs       ClientFoodLog[]
}

model ClientProgressLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  weight    Float?
  chest     Float?
  waist     Float?
  biceps    Float?
  thigh     Float?
  notes     String?
  loggedAt  DateTime @default(now())

  @@index([clientId, loggedAt])
}

model WorkoutSessionLog {
  id                 String   @id @default(cuid())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  routineId          String?
  dayLabel           String
  durationMinutes    Int?
  completedExercises Int      @default(0)
  totalExercises     Int      @default(0)
  notes              String?
  setDetails         String?  // JSON string containing set-by-set weight and reps
  completedAt        DateTime @default(now())

  @@index([clientId, completedAt])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  senderRole  Role
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId, createdAt])
}

model Subscription {
  id        String             @id @default(cuid())
  clientId  String
  client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   Trainer            @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  planName  String             // e.g. "برنامه ۱ ماهه VIP"
  startDate DateTime
  endDate   DateTime
  status    SubscriptionStatus @default(ACTIVE)
  price     Float?
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([clientId])
  @@index([trainerId])
  @@index([clientId, status, endDate])
}

model Routine {
  id           String   @id @default(cuid())
  trainerId    String?
  trainer      Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  title        String
  description  String?
  isTemplate   Boolean  @default(true) // True for templates, False for assigned clones
  sportContext Json?    // Sport specific AI context (sport, target muscles, notes)

  workoutDays  WorkoutDay[]
  history      ClientRoutineHistory[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([trainerId, isTemplate])
}

model ClientRoutineHistory {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([routineId])
}

model DietPlan {
  id          String   @id @default(cuid())
  trainerId   String?
  trainer     Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  title       String
  description String?
  content     String   // Rich HTML content of the diet plan
  sectionsJson Json?   // Structured JSON content of the diet plan
  isTemplate  Boolean  @default(true) // True for templates, False for assigned clones

  history     ClientDietHistory[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([trainerId, isTemplate])
}

model ClientDietHistory {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dietPlanId String
  dietPlan   DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@index([dietPlanId])
}

model WorkoutDay {
  id        String   @id @default(cuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  day       Day
  label     String?  // e.g. "روز اول - سینه و سرشانه"
  order     Int      @default(0)

  exercises Exercise[]
}

model Exercise {
  id                String     @id @default(cuid())
  workoutDayId      String
  workoutDay        WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  name              String
  muscleGroup       String?    // e.g. "سینه", "پشت"
  sets              Int
  repetitions       String     // e.g. "10-12", "تا ناتوانی"
  restTime          String?    // e.g. "60 ثانیه"
  weight            String?    // e.g. "80 کیلو"
  customDescription String?
  videoUrl          String?
  gifUrl            String?    // Direct GIF animation URL / preview
  order             Int        @default(0)
  groupType         ExerciseGroupType @default(NORMAL)
  groupId           String?    // Shared ID to link exercises in a superset/triset
}

model ExerciseDictionary {
  id          String   @id @default(cuid())
  name        String
  muscleGroup String
  description String?
  videoUrl    String?
  gifUrl      String?  // Direct GIF animation URL / preview
  createdAt   DateTime @default(now())

  @@index([muscleGroup])
}

model Recipe {
  id           String   @id @default(cuid())
  trainerId    String?
  trainer      Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  title        String
  category     String   // e.g. "صبحانه", "میان وعده", "ناهار/شام", "پروتئینی"
  prepTime     String?  // e.g. "15 دقیقه"
  calories     Int?
  protein      Float?   // grams
  carbs        Float?   // grams
  fats         Float?   // grams
  ingredients  String   // Multiline or JSON ingredients list
  instructions String   // Preparation steps
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FoodDictionary {
  id          String   @id @default(cuid())
  name        String   // e.g. "سینه مرغ پخته"
  category    String   // e.g. "پروتئینی", "کربوهیدرات", "چربی", "میوه و سبزیجات"
  unitLabel   String   @default("100 گرم")
  calories    Float    // kcal per unit
  protein     Float    // grams
  carbs       Float    // grams
  fats        Float    // grams
  createdAt   DateTime @default(now())

  @@index([category, name])
}

model ClientFoodLog {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  foodName    String
  mealType    String   // e.g. "BREAKFAST", "LUNCH", "DINNER", "SNACK"
  amount      Float    @default(1) // multiplier of unit
  unitLabel   String   @default("100 گرم")
  calories    Float
  protein     Float
  carbs       Float
  fats        Float
  loggedAt    DateTime @default(now())

  @@index([clientId])
}

