# -------------------------------------------------------------
# Gym-Scale (NutriTrain) - Environment Configuration Template
# Duplicate this file to .env on your VPS and update the values:
#   cp .env.example .env
# -------------------------------------------------------------

# PostgreSQL Connection String
# Example: postgresql://USER:PASSWORD@127.0.0.1:5432/nutritrain_db?schema=public
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/nutritrain_db?schema=public"

# NextAuth / Auth.js Configuration
# Generate a secure 32-character string using: openssl rand -base64 32
AUTH_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY"

# Public URL of your deployment (used by NextAuth for callbacks and redirects)
# In production, set this to your domain: e.g. https://yourdomain.com
AUTH_URL="https://yourdomain.com"
NEXTAUTH_URL="https://yourdomain.com"

# Initial SuperAdmin Credentials (used by `npm run seed`)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_TO_A_STRONG_PASSWORD"

# AI Routine & Diet Generation (GapGPT / OpenAI compatible API endpoint)
GAPGPT_API_KEY="YOUR_GAPGPT_OR_OPENAI_API_KEY"
GAPGPT_BASE_URL="https://api.gapgpt.app/v1"

# Production Environment & Port
NODE_ENV="production"
PORT=3000
